From 387225632ebaf0f193963f5ee6b8abfb0d42594c Mon Sep 17 00:00:00 2001
From: KextIntel <kextintel@users.noreply.github.com>
Date: Tue, 27 Oct 2026 09:42:31 +0700
Subject: [PATCH 2/2] KextIntel: eDP backlight duty against the firmware PWM
 period (64-bit), -wex-blfreq-off

---
 WhateverXe/kern_xe.cpp                  | 55 +++++++++++++++++++++++++
 WhateverXe/kern_xe.hpp                  |  4 ++
 tests/fixtures/boot_argument_names.json |  3 +-
 3 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index bea3831..1a84d08 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -12818,6 +12818,34 @@ void XE::processNativePanel(KernelPatcher &patcher,size_t index,mach_vm_address_
     // ADLS_PANEL_PWM_INSTALL_END
    }
 
+			// KextIntel: the donor derives its PWM period (+0xE60) from the PCH raw clock
+			// (17777) and only programs BLC_PWM_FREQ1 in LightUpEDP. Adopting the firmware-lit
+			// panel keeps the firmware period (96000 on this Lenovo VBT, 200 Hz), so native
+			// hwSetBacklight caps the duty at 17777/96000 (18.5%). Its 32-bit period*level
+			// product would also wrap above ~68% with the real period. Use the period the
+			// hardware runs and a 64-bit product. -wex-blfreq-off keeps the native path.
+			if (tglActive && !adlsDisplaySelected && !display13FramebufferRequested && !checkKernelArgument("-wex-blfreq-off")) {
+				const char *symbol="__ZN31AppleIntelFramebufferController14hwSetBacklightEj";
+				const auto setBacklight=patcher.solveSymbol<mach_vm_address_t>(index,symbol,address,size);
+				patcher.clearError();
+				kxReadRegister32=patcher.solveSymbol<mach_vm_address_t>(index,
+					"__ZN31AppleIntelRegisterAccessManager14ReadRegister32Em",address,size);
+				patcher.clearError();
+				kxWriteRegister32=patcher.solveSymbol<mach_vm_address_t>(index,
+					"__ZN31AppleIntelRegisterAccessManager15WriteRegister32Emj",address,size);
+				patcher.clearError();
+				// movq 0xC40(%rbx),%rdi ; movl 0xE60(%rbx),%eax
+				const uint8_t expected[] {0x48,0x8B,0xBB,0x40,0x0C,0,0,0x8B,0x83,0x60,0x0E,0,0};
+				const bool known=size>0x5EB5C && setBacklight==address+0x4A56A &&
+					kxReadRegister32==address+0x5E344 && kxWriteRegister32==address+0x5EB5C &&
+					!memcmp(reinterpret_cast<void *>(setBacklight+0x2F),expected,sizeof(expected));
+				KernelPatcher::RouteRequest route(symbol,wrapKXSetBacklight,orgKXSetBacklight);
+				const bool routed=known && patcher.routeMultiple(index,&route,1,address,size);
+				if(!routed)kxReadRegister32=kxWriteRegister32=0;
+				IORegistryEntry::getRegistryRoot()->setProperty("KextIntelBacklightRouted",routed);
+				patcher.clearError();
+			}
+
 			if (tglActive) {
 				// TGL/Xe-LP has no dedicated eDP transcoder. Keep the allocated
 				// pipe (or getTranscoderOffset's pipe argument), including when
@@ -13022,6 +13050,33 @@ bool XE::wrapTGLPanelPowerProperty(IORegistryEntry *framebuffer, const char *, O
 // HDMI routing follows firmware wiring or an explicit board override.
 // Copy the donor description before any port/FB is constructed. A malformed
 // explicit profile or a mismatched donor connector must not be partly applied.
+int XE::wrapKXSetBacklight(void *controller, uint32_t level) {
+	auto self = callbackXE;
+	auto c = static_cast<uint8_t *>(controller);
+	auto manager = c ? *reinterpret_cast<void **>(c + 0xC40) : nullptr;
+	if (!manager || !self->kxReadRegister32 || !self->kxWriteRegister32)
+		return FunctionCast(wrapKXSetBacklight, self->orgKXSetBacklight)(controller, level);
+	const auto read = reinterpret_cast<uint32_t (*)(void *, unsigned long)>(self->kxReadRegister32);
+	const auto write = reinterpret_cast<void (*)(void *, unsigned long, uint32_t)>(self->kxWriteRegister32);
+	auto &period = *reinterpret_cast<uint32_t *>(c + 0xE60);
+	const auto hardware = read(manager, 0xC8254);  // BLC_PWM_FREQ1
+	// Only trust a sane, enabled period; never invent one.
+	if (hardware >= 0x100 && hardware <= 0x200000 && hardware != period) {
+		self->kxBacklightRecord[0] = period;
+		period = hardware;
+		self->kxBacklightRecord[1] = hardware;
+	}
+	const uint32_t clamped = level > 0xFFFF ? 0xFFFF : level;
+	const uint32_t duty = static_cast<uint32_t>((static_cast<uint64_t>(period) * clamped) / 0xFFFF);
+	write(manager, 0xC8258, duty);  // BLC_PWM_DUTY1
+	*reinterpret_cast<uint32_t *>(c + 0xE58) = level;
+	// {donor period before, firmware period applied, last level, calls}
+	self->kxBacklightRecord[2] = level;
+	if (++self->kxBacklightRecord[3] <= 4 || (self->kxBacklightRecord[3] & 15) == 0)
+		IORegistryEntry::getRegistryRoot()->setProperty("KextIntelBacklight", self->kxBacklightRecord, sizeof(self->kxBacklightRecord));
+	return 0;
+}
+
 bool XE::wrapTGLGetOSInformation(void *controller) {
  const auto r=FunctionCast(wrapTGLGetOSInformation,callbackXE->orgTGLGetOSInformation)(controller);
  if(r && !callbackXE->adlsDisplaySelected)tglBeginTCColdProtection(controller);
